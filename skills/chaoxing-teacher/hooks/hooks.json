{
  "description": "Allow only direct calls to this plugin's bundled Chaoxing runner.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CODEBUDDY_PLUGIN_ROOT}/bin/run-node\" \"${CODEBUDDY_PLUGIN_ROOT}/scripts/workbuddy_permission_hook.mjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
